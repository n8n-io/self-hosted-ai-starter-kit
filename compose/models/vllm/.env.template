# required
# v0.32.0 and later crash on cpu without triton while this issue is open: https://github.com/vllm-project/vllm/issues/61131
VLLM_VERSION=v0.31.0
# The API key clients send as bearer token to the /v1 endpoints, generated by `pnpm run setup` (see ./.env.secrets.json)
VLLM_API_KEY=

# optional, defaults live in ./docker-compose.yml
# Hugging Face token, only needed for gated models, set with `pnpm run secrets set HF_TOKEN`
# HF_TOKEN=
# KV cache size in GiB of one container on the cpu runtimes, the weights load on top (see ../../../SPEC.md)
# VLLM_CPU_KVCACHE_SPACE=2
# Extra `vllm serve` flags for this machine, appended after the catalogue and runtime flags; text only saves about 2.5 GB per container (see ../../../SPEC.md)
# VLLM_EXTRA_ARGS='--limit-mm-per-prompt={"image":0,"video":0}'
