# required
LITELLM_VERSION=v1.108.4
# secrets, generated by `pnpm run setup`, see ./.env.secrets.json
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
# the litellm-db service of ./docker-compose.yml, the password is generated by `pnpm run setup`
LITELLM_DB_PASSWORD=
# copied from VLLM_API_KEY of ../vllm/.env by `pnpm run setup`, see ./.env.secrets.json
VLLM_API_KEY=

# optional, defaults live in ./docker-compose.yml
# LITELLM_DB_USER=litellm
# LITELLM_DB_NAME=litellm
