# required, all variants
N8N_VERSION=2.46.6
# secrets, generated by `pnpm run setup`, see ./.env.secrets.json
N8N_ENCRYPTION_KEY=
N8N_USER_MANAGEMENT_JWT_SECRET=

# required, build, community and enterprise variants, see ./docker-compose.build.yml
# the shared secret of the external task runner, generated by `pnpm run setup`, see ./.env.secrets.json
N8N_RUNNERS_AUTH_TOKEN=
# postgres, same values as ../storage/postgres/.env
DB_POSTGRESDB_USER=changeUser
# copied from POSTGRES_PASSWORD of ../storage/postgres/.env by `pnpm run setup`, see ./.env.secrets.json
DB_POSTGRESDB_PASSWORD=

# required, enterprise variant, see ./docker-compose.enterprise.yml
# set with `pnpm run secrets set N8N_LICENSE_ACTIVATION_KEY`, see ./.env.secrets.json
N8N_LICENSE_ACTIVATION_KEY=

# optional, all variants, defaults live in ./docker-compose.yml
# hosting, Options: http or https
# N8N_PROTOCOL=http
# Set to true when running behind https
# N8N_SECURE_COOKIE=false
# Proxies in front of n8n, traefik counts as 1
# N8N_PROXY_HOPS=1
# N8N_LOG_LEVEL=info
# TZ=Europe/Berlin
# Code node JavaScript imports, comma separated, * for all; dev passes them to the internal runner, the other variants through ./n8n-task-runners.json
# NODE_FUNCTION_ALLOW_BUILTIN=crypto,buffer,url,util,path,events,stream,zlib,assert
# NODE_FUNCTION_ALLOW_EXTERNAL=moment,luxon,lodash,nanoid

# optional, build, community and enterprise variants, see ./docker-compose.build.yml
# Code node Python imports, comma separated, * for all, passed to the runners through ./n8n-task-runners.json (Python needs the external runner)
# N8N_RUNNERS_STDLIB_ALLOW=json,re,datetime,time,math,random,statistics,decimal,collections,itertools,functools,string,textwrap,uuid,base64,hashlib,hmac,urllib,typing,dataclasses,enum,copy
# N8N_RUNNERS_EXTERNAL_ALLOW=
# postgres, same values as ../storage/postgres/.env
# DB_POSTGRESDB_DATABASE=n8n

# optional, community and enterprise variants, see ./docker-compose.community.yml
# queue
# OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
# QUEUE_WORKER_CONCURRENCY=10
# Keep 1 while an MCP Server Trigger is in use, its SSE connections need a single replica
# N8N_WEBHOOK_REPLICAS=1
# Main stops serving production webhooks, they are routed to hooks.<DOMAIN>
# N8N_DISABLE_PRODUCTION_MAIN_PROCESS=true

# optional, enterprise variant, see ./docker-compose.enterprise.yml
# N8N_LICENSE_TENANT_ID=1001
