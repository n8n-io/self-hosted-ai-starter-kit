# required, all variants
N8N_VERSION=2.49.7
# secrets, generated by `pnpm run setup`, see ./.env.json
N8N_ENCRYPTION_KEY=
N8N_USER_MANAGEMENT_JWT_SECRET=
# bcrypt hash of the owner password, derived by `pnpm run setup` from N8N_INSTANCE_OWNER_PASSWORD of ./.env.secrets, see ./.env.json
N8N_INSTANCE_OWNER_PASSWORD_HASH=

# required, build, community and enterprise variants, see ./docker-compose.build.yml
# the shared secret of the external task runner, generated by `pnpm run setup`, see ./.env.json
N8N_RUNNERS_AUTH_TOKEN=
# postgres, same values as ../storage/postgres/.env
DB_POSTGRESDB_USER=changeUser
# copied from POSTGRES_PASSWORD of ../storage/postgres/.env by `pnpm run setup`, see ./.env.json
DB_POSTGRESDB_PASSWORD=

# required, enterprise variant, see ./docker-compose.enterprise.yml
# set with `pnpm run secrets set N8N_LICENSE_ACTIVATION_KEY`, see ./.env.json
N8N_LICENSE_ACTIVATION_KEY=

# optional, all variants, defaults live in ./docker-compose.yml
# instance owner, applied on every start while managed by env (its fields are then read-only in the UI); `pnpm run secrets read n8n` prints the login
# N8N_INSTANCE_OWNER_MANAGED_BY_ENV=true
# N8N_INSTANCE_OWNER_EMAIL=owner@example.com
# N8N_INSTANCE_OWNER_FIRST_NAME=Instance
# N8N_INSTANCE_OWNER_LAST_NAME=Owner
# hosting, Options: http or https
# N8N_PROTOCOL=http
# Set to true when running behind https
# N8N_SECURE_COOKIE=false
# Proxies in front of n8n, traefik counts as 1
# N8N_PROXY_HOPS=1
# logs, Options: error, warn, info or debug
# N8N_LOG_LEVEL=info
# Options: console,file or console; the files are JSON lines in .volumes/n8n/logs, one per n8n process, and the console stays on for Tilt
# N8N_LOG_OUTPUT=console,file
# Max size of one log file in MB, and how many files each n8n process keeps before the oldest is deleted
# N8N_LOG_FILE_SIZE_MAX=16
# N8N_LOG_FILE_COUNT_MAX=10
# TZ=Europe/Berlin
# Code node JavaScript imports, comma separated, * for all; dev passes them to the internal runner, the other variants through ./n8n-task-runners.json
# NODE_FUNCTION_ALLOW_BUILTIN=crypto,buffer,url,util,path,events,stream,zlib,assert
# NODE_FUNCTION_ALLOW_EXTERNAL=moment,luxon,lodash,nanoid
# n8n Assistant, switched on by N8N_ASSISTANT of the root .env; `pnpm run config N8N_ASSISTANT` writes its model and, for a model of AI_MODELS, the url of the engine
# N8N_INSTANCE_AI_MODEL=anthropic/claude-opus-5-5
# N8N_INSTANCE_AI_MODEL_URL=
# the key of the cloud provider, or the VLLM_API_KEY of ../models/vllm/.env for a vllm model, set with `pnpm run secrets set N8N_INSTANCE_AI_MODEL_API_KEY`, see ./.env.json
# N8N_INSTANCE_AI_MODEL_API_KEY=
# the key of the sandbox API, copied from SANDBOX_API_KEYS of ./assistant/.env by `pnpm run setup`, see ./.env.json
# N8N_SANDBOX_SERVICE_API_KEY=

# optional, build, community and enterprise variants, see ./docker-compose.build.yml
# Code node Python imports, comma separated, * for all, passed to the runners through ./n8n-task-runners.json (Python needs the external runner)
# N8N_RUNNERS_STDLIB_ALLOW=json,re,datetime,time,math,random,statistics,decimal,collections,itertools,functools,string,textwrap,uuid,base64,hashlib,hmac,urllib,typing,dataclasses,enum,copy
# N8N_RUNNERS_EXTERNAL_ALLOW=
# postgres, same values as ../storage/postgres/.env
# DB_POSTGRESDB_DATABASE=n8n

# optional, community and enterprise variants, see ./docker-compose.community.yml
# queue
# OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
# QUEUE_WORKER_CONCURRENCY=10
# Keep 1 while an MCP Server Trigger is in use, its SSE connections need a single replica
# N8N_WEBHOOK_REPLICAS=1
# Main stops serving production webhooks, they are routed to hooks.<DOMAIN>
# N8N_DISABLE_PRODUCTION_MAIN_PROCESS=true

# optional, enterprise variant, see ./docker-compose.enterprise.yml
# N8N_LICENSE_TENANT_ID=1001
