# required
# one release pins the sandbox API, runner and sandbox images, here the one https://github.com/n8n-io/n8n/blob/master/docker/get-n8n.sh installs
N8N_SANDBOX_VERSION=1.8.1
SEARXNG_VERSION=2026.11.23-a7163d091
# secrets, generated by `pnpm run setup`, see ./.env.json
# the key n8n sends to the sandbox API, N8N_SANDBOX_SERVICE_API_KEY of ../.env is a copy of it
SANDBOX_API_KEYS=
# shared by the sandbox API and its runner
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=
SANDBOX_API_RUNNER_API_KEY=
SEARXNG_SECRET=
