{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Secrets manifest",
  "description": "The secret keys of the .env.template next to this manifest and how n8n-starter fills them; the CLI validates the same shape in packages/cli/src/schemas/secrets.ts, see ../SPEC.md",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "secrets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "required": [ "secrets" ],
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "oneOf": [
        { "$ref": "#/$defs/generate" },
        { "$ref": "#/$defs/prompt" },
        { "$ref": "#/$defs/link" }
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "What the secret protects; the message of the `secrets set` prompt"
    },
    "generate": {
      "type": "object",
      "description": "A random value `setup` writes once when the key is empty or still holds the template value",
      "properties": {
        "source": { "const": "generate" },
        "description": { "$ref": "#/$defs/description" },
        "rotation": {
          "type": "string",
          "enum": [ "free", "manual", "never" ],
          "default": "free",
          "description": "What changing the value later costs: nothing beyond a restart, a manual step in the service (a database password), or the data in .volumes/ (an encryption key)"
        },
        "bytes": { "type": "integer", "minimum": 16, "maximum": 64, "default": 32 },
        "encoding": { "type": "string", "enum": [ "hex", "base64url" ], "default": "hex" },
        "prefix": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$", "default": "" }
      },
      "required": [ "source", "description" ],
      "additionalProperties": false
    },
    "prompt": {
      "type": "object",
      "description": "A value a human sets with `secrets set`; `verify` fails without it only under the listed root .env values",
      "properties": {
        "source": { "const": "prompt" },
        "description": { "$ref": "#/$defs/description" },
        "required": {
          "type": "object",
          "minProperties": 1,
          "description": "The root .env values the secret is required under; every listed key must match",
          "properties": {
            "N8N_VARIANT": { "type": "array", "minItems": 1, "items": { "enum": [ "dev", "build", "community", "enterprise" ] } },
            "AI_ENGINE": { "type": "array", "minItems": 1, "items": { "enum": [ "ollama", "vllm" ] } },
            "AI_RUNTIME": { "type": "array", "minItems": 1, "items": { "enum": [ "cpu-arm64", "cpu-x86-64", "gpu-nvidia", "gpu-amd" ] } }
          },
          "additionalProperties": false
        }
      },
      "required": [ "source", "description" ],
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "description": "A copy of a generate or prompt secret of another directory, kept in sync by `setup` and `secrets set`",
      "properties": {
        "source": { "const": "link" },
        "from": { "type": "string", "minLength": 1, "description": "The directory of the source manifest, relative to this one" },
        "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
      },
      "required": [ "source", "from", "key" ],
      "additionalProperties": false
    }
  }
}
