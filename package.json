{
  "name": "self-hosted-ai-starter-kit",
  "version": "1.0.0",
  "description": "A Docker Compose service catalogue that runs n8n with local AI models, orchestrated by Tilt and configured by the n8n-starter CLI.",
  "main": "index.js",
  "scripts": {
    "cli": "node packages/cli/dist/index.mjs",
    "config": "node packages/cli/dist/index.mjs config",
    "models": "node packages/cli/dist/index.mjs models",
    "secrets": "node packages/cli/dist/index.mjs secrets",
    "setup": "node packages/cli/dist/index.mjs setup",
    "verify": "node packages/cli/dist/index.mjs verify",
    "dev": "tilt up; tilt down",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "reset": "node packages/cli/dist/index.mjs reset"
  },
  "keywords": [],
  "author": "n8n",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
