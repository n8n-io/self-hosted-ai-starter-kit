N8N_VERSION=2.46.6
POSTGRES_VERSION=18.6-alpine3.24

POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=n8n

N8N_ENCRYPTION_KEY=super-secret-key
N8N_USER_MANAGEMENT_JWT_SECRET=even-more-secret
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# External task runner. Generate one random 64-character hex token and keep
# the same value on the n8n and n8n-runners services.
N8N_RUNNERS_AUTH_TOKEN=replace-with-generated-64-character-hex-token
N8N_RUNNERS_TASK_TIMEOUT=300

# Explicit secure defaults for upcoming n8n changes.
N8N_UNVERIFIED_PACKAGES_ENABLED=false
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=268435456
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=1000

# For Mac users running OLLAMA locally
# See https://github.com/n8n-io/self-hosted-ai-starter-kit?tab=readme-ov-file#for-mac--apple-silicon-users
# OLLAMA_HOST=host.docker.internal:11434

# n8n Sandbox Service (local development and testing)
# Generate three independent random secrets. Matching pairs must stay equal.
N8N_SANDBOX_VERSION=1.8.1
N8N_INSTANCE_AI_SANDBOX_ENABLED=true
N8N_INSTANCE_AI_SANDBOX_PROVIDER=n8n-sandbox
N8N_INSTANCE_AI_SANDBOX_API_URL=http://sandbox-api:8080
N8N_SANDBOX_SERVICE_URL=http://sandbox-api:8080

SANDBOX_API_KEYS=replace-with-random-api-key
N8N_SANDBOX_SERVICE_API_KEY=replace-with-random-api-key

SANDBOX_API_RUNNER_REGISTRATION_TOKEN=replace-with-random-registration-token
SANDBOX_RUNNER_REGISTRATION_TOKEN=replace-with-random-registration-token

SANDBOX_API_RUNNER_API_KEY=replace-with-random-runner-key
SANDBOX_RUNNER_API_KEYS=replace-with-random-runner-key

# Local model for n8n Assistant. The internal adapter normalizes Ollama's
# multi-step tool-call history and is not exposed on a host port.
N8N_INSTANCE_AI_MODEL=gpt-oss-20b-n8n
N8N_INSTANCE_AI_MODEL_URL=http://ollama-adapter:11435/v1
N8N_INSTANCE_AI_MODEL_API_KEY=ollama
N8N_INSTANCE_AI_REASONING_EFFORT=low


